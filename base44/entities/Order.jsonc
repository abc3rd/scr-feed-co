{
  "name": "Order",
  "type": "object",
  "properties": {
    "user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending Ticket",
        "Picking",
        "Ready",
        "Done",
        "Cancelled"
      ]
    },
    "location": {
      "type": "string",
      "enum": [
        "LaBelle",
        "Fort Myers"
      ]
    },
    "fulfillment": {
      "type": "string",
      "enum": [
        "pickup",
        "delivery"
      ]
    },
    "date": {
      "type": "string"
    },
    "holdAmount": {
      "type": [
        "number",
        "null"
      ]
    },
    "finalAmount": {
      "type": [
        "number",
        "null"
      ]
    },
    "releasedAmount": {
      "type": [
        "number",
        "null"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "sku",
          "name",
          "qty"
        ]
      }
    }
  },
  "required": [
    "user_id",
    "status",
    "location",
    "fulfillment",
    "date",
    "lines"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
